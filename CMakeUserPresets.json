        "CATA_CCACHE": "ON",
        "CCACHE_FOUND": "C:/Users/maksi/AppData/Local/Microsoft/WinGet/Packages/Ccache.Ccache_Microsoft.Winget.Source_8wekyb3d8bbwe/ccache-4.14.1-windows-x86_64/ccache.exe",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/build/windows-tiles-sounds-x64-msvc/vcpkg_installed",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
        "CATA_PCH": "ON",
        "LUA_DOCS_ON_BUILD": "OFF",
        "CATA_MSVC_FAST_LINK": "ON"
